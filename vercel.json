{
  "builds": [
    {
      "src": "apps/internal-management/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "apps/agen-marketing/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "apps/jamaah-timlapangan/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/marketing/(.*)",
      "dest": "/apps/agen-marketing/$1"
    },
    {
      "src": "/jamaah/(.*)",
      "dest": "/apps/jamaah-timlapangan/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/apps/internal-management/$1"
    }
  ]
}
