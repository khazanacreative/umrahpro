{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/apps/internal-management/$1"
    }
  ],
  "routes": [
    {
      "src": "/marketing/(.*)",
      "dest": "/apps/agen-marketing/$1"
    },
    {
      "src": "/jamaah/(.*)",
      "dest": "/apps/jamaah-timlapangan/$1"
    }
  ]
}
