{
  "name": "umrahpro-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:admin": "cd apps/internal-management && npm run dev",
    "dev:agen": "cd apps/agen-marketing && npm run dev",
    "dev:jamaah": "cd apps/jamaah-timlapangan && npm run dev",
    "build": "npm run build --workspaces",
    "install:all": "npm install"
  }
}